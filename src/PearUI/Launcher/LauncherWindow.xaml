<shell:OverlayWindow x:Class="PearUI.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:PearUI.Shell"
        Title="PearUI Search" Width="680" SizeToContent="Height">
        <StackPanel>
            <Grid Height="54" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="20" Opacity="0.6"
                           Foreground="{DynamicResource Brush.Text}" Margin="2,0,12,0"/>
                <TextBox x:Name="Query" Grid.Column="1" FontSize="22" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}"
                         VerticalContentAlignment="Center" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown"/>
                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Search apps, files, settings…" FontSize="22"
                           Foreground="{DynamicResource Brush.SecondaryText}" VerticalAlignment="Center" Margin="3,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>
            <Border x:Name="Divider" Height="1" Background="{DynamicResource Brush.Separator}" Visibility="Collapsed"/>
            <ListBox x:Name="Results" MaxHeight="440" Background="Transparent" BorderThickness="0" Margin="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"
                     MouseUp="Results_MouseUp" Focusable="False">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="10,6" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="20"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.65" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SubtitleVisibility}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="11.5" Opacity="0.55"
                                       VerticalAlignment="Center" Margin="12,0,4,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="Footer" Padding="16,6,16,8" Visibility="Collapsed">
                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.SecondaryText}"
                           Text="↑↓ to navigate   ↵ to open   Ctrl+↵ show in File Explorer   Esc to close"/>
            </Border>
        </StackPanel>
</shell:OverlayWindow>
