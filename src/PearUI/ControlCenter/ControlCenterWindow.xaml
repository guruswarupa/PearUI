<shell:OverlayWindow x:Class="MacUI.ControlCenter.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:MacUI.Shell"
        Title="PearUI Control Center" Width="320" SizeToContent="Height">
    <Window.Resources>
        <!-- Square tile: icon on top, label below; turns white with an accent icon when on (macOS style). -->
        <Style x:Key="SquareTile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource Brush.Tile}"
                                BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0.5" Padding="4,10,4,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="18"/>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="#1D1D1F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Border Padding="8" TextElement.Foreground="{DynamicResource Brush.Text}">
        <StackPanel>
            <!-- ============ Row 1: connectivity | Focus + square tiles ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Tile}" Padding="10,8">
                    <StackPanel VerticalAlignment="Center">
                        <ToggleButton x:Name="WifiToggle" Style="{StaticResource TileToggle}" Tag="&#xE701;" Click="Wifi_Click"
                                      MouseRightButtonUp="Wifi_RightClick" Margin="0,8"
                                      ToolTip="Click to turn Wi‑Fi on or off · right-click to choose a network">
                            <StackPanel>
                                <TextBlock Text="Wi‑Fi" Style="{StaticResource TileTitle}"/>
                                <TextBlock x:Name="WifiName" Text="…" Style="{StaticResource TileSub}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="BluetoothToggle" Style="{StaticResource TileToggle}" Tag="&#xE702;" Click="Bluetooth_Click"
                                      MouseRightButtonUp="Bluetooth_RightClick" Margin="0,8"
                                      ToolTip="Click to turn Bluetooth on or off · right-click to choose a device">
                            <StackPanel>
                                <TextBlock Text="Bluetooth" Style="{StaticResource TileTitle}"/>
                                <TextBlock x:Name="BluetoothState" Text="…" Style="{StaticResource TileSub}"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="StageToggle" Style="{StaticResource SquareTile}" Tag="&#xE7C4;" Click="Stage_Click">
                        <TextBlock Text="Stage&#x0a;Manager" TextAlignment="Center" FontSize="11.5" LineHeight="13"/>
                    </ToggleButton>
                    <ToggleButton x:Name="CastToggle" Grid.Column="1" Style="{StaticResource SquareTile}" Tag="&#xEC15;" Click="Cast_Click">
                        <TextBlock Text="Screen&#x0a;Mirroring" TextAlignment="Center" FontSize="11.5" LineHeight="13"/>
                    </ToggleButton>
                </Grid>
            </Grid>

            <!-- ============ Display ============ -->
            <Border x:Name="DisplayTile" Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource TileTitle}" Margin="2,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <shell:PillSlider x:Name="BrightnessSlider" Glyph="&#xE706;" UserChanged="Brightness_Changed" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="DarkToggle" Grid.Column="1" Style="{StaticResource TileToggle}" Tag="&#xE790;"
                                      Margin="8,0,0,0" Click="Dark_Click" ToolTip="Dark Mode"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Sound ============ -->
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Sound" Style="{StaticResource TileTitle}" Margin="2,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <shell:PillSlider x:Name="VolumeSlider" Glyph="&#xE995;" UserChanged="Volume_Changed" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource RoundButton}" Margin="8,0,0,0" Width="28" Height="28"
                                Click="Mute_Click" ToolTip="Mute">
                            <TextBlock x:Name="MuteGlyph" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="12"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Now playing ============ -->
            <Border x:Name="MediaTile" Style="{StaticResource Tile}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="2,0,8,0">
                        <TextBlock x:Name="MediaTitle" Text="Not Playing" Style="{StaticResource TileTitle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MediaArtist" Style="{StaticResource TileSub}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource RoundButton}" Background="Transparent" Click="Prev_Click">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE892;" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource RoundButton}" Background="Transparent" Click="PlayPause_Click">
                            <TextBlock x:Name="PlayGlyph" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="15"/>
                        </Button>
                        <Button Style="{StaticResource RoundButton}" Background="Transparent" Click="Next_Click">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</shell:OverlayWindow>
