<shell:OverlayWindow x:Class="PearUI.ControlCenter.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:PearUI.Shell"
        Title="PearUI Control Center" Width="332" SizeToContent="Height">
    <Window.Resources>
        <!-- Round tile (macOS style): circle that turns white with an accent glyph when on. -->
        <Style x:Key="CircleTile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{DynamicResource Brush.Tile}" Stroke="{DynamicResource Brush.Separator}" StrokeThickness="1"/>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="20"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="Fill" Value="White"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Wide pill tile: round icon + label. -->
        <Style x:Key="PillTile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="30" Background="{DynamicResource Brush.Tile}"
                                BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="1" Padding="6,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40">
                                    <Ellipse x:Name="Circle" Fill="{DynamicResource Brush.TileIcon}"/>
                                    <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="16"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="White"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{DynamicResource Brush.Tile}" Stroke="{DynamicResource Brush.Separator}" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Border Padding="14" TextElement.Foreground="{DynamicResource Brush.Text}">
        <!-- Shadow around every tile so they stand out over same-coloured windows (light on light, dark on dark). -->
        <StackPanel>
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black"/>
            </StackPanel.Effect>
            <!-- ============ Top block: Wi-Fi / round tiles | media ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ToggleButton x:Name="WifiToggle" Style="{StaticResource PillTile}" Tag="&#xE701;" Click="Wifi_Click"
                              MouseRightButtonUp="Wifi_RightClick"
                              ToolTip="Click to turn Wi‑Fi on or off · right-click to choose a network">
                    <StackPanel>
                        <TextBlock Text="Wi‑Fi" Style="{StaticResource TileTitle}"/>
                        <TextBlock x:Name="WifiName" Text="…" Style="{StaticResource TileSub}"/>
                    </StackPanel>
                </ToggleButton>

                <UniformGrid Grid.Row="1" Columns="2">
                    <ToggleButton x:Name="BluetoothToggle" Style="{StaticResource CircleTile}" Tag="&#xE702;" Click="Bluetooth_Click"
                                  MouseRightButtonUp="Bluetooth_RightClick" HorizontalAlignment="Center"
                                  ToolTip="Bluetooth · right-click to choose a device"/>
                    <ToggleButton x:Name="DarkToggle" Style="{StaticResource CircleTile}" Tag="&#xE790;" HorizontalAlignment="Center"
                                  Click="Dark_Click" ToolTip="Dark Mode"/>
                </UniformGrid>

                <!-- Now playing -->
                <Border x:Name="MediaTile" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Tile}" CornerRadius="26" Padding="12,12,12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Width="42" Height="42" CornerRadius="8" HorizontalAlignment="Left" Background="{DynamicResource Brush.TileIcon}">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="18"/>
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush x:Name="MediaArt" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock x:Name="MediaTitle" Text="Not Playing" Style="{StaticResource TileTitle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MediaArtist" Style="{StaticResource TileSub}"/>
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource RoundButton}" Background="Transparent" Click="Prev_Click">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE892;" FontSize="13"/>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource RoundButton}" Background="Transparent" Click="PlayPause_Click">
                                <TextBlock x:Name="PlayGlyph" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="16"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource RoundButton}" Background="Transparent" Click="Next_Click">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" FontSize="13"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <ToggleButton x:Name="FocusToggle" Grid.Row="2" Style="{StaticResource PillTile}" Tag="&#xE708;" Click="Focus_Click"
                              ToolTip="Do Not Disturb">
                    <TextBlock Text="Focus" Style="{StaticResource TileTitle}"/>
                </ToggleButton>

                <UniformGrid Grid.Row="2" Grid.Column="1" Columns="2">
                    <ToggleButton x:Name="StageToggle" Style="{StaticResource CircleTile}" Click="Stage_Click"
                                  HorizontalAlignment="Center" ToolTip="Stage Manager">
                        <!-- Stage Manager symbol: the active window plus a column of recent-window dots -->
                        <Canvas Width="26" Height="20">
                            <Rectangle Canvas.Left="9" Canvas.Top="1" Width="16" Height="18" RadiusX="3.5" RadiusY="3.5"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="2"/>
                            <Rectangle Canvas.Left="1" Canvas.Top="2" Width="4" Height="4" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <Rectangle Canvas.Left="1" Canvas.Top="8" Width="4" Height="4" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            <Rectangle Canvas.Left="1" Canvas.Top="14" Width="4" Height="4" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Canvas>
                    </ToggleButton>
                    <ToggleButton x:Name="CastToggle" Style="{StaticResource CircleTile}" Tag="&#xEC15;" Click="Cast_Click"
                                  HorizontalAlignment="Center" ToolTip="Screen Mirroring"/>
                </UniformGrid>
            </Grid>

            <!-- ============ Display ============ -->
            <Border x:Name="DisplayTile" Style="{StaticResource Tile}" CornerRadius="22">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource TileTitle}" Margin="4,0,0,8"/>
                    <shell:PillSlider x:Name="BrightnessSlider" Glyph="&#xE706;" UserChanged="Brightness_Changed"/>
                </StackPanel>
            </Border>

            <!-- ============ Sound ============ -->
            <Border Style="{StaticResource Tile}" CornerRadius="22">
                <StackPanel>
                    <TextBlock Text="Sound" Style="{StaticResource TileTitle}" Margin="4,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <shell:PillSlider x:Name="VolumeSlider" Glyph="&#xE995;" UserChanged="Volume_Changed" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource RoundButton}" Margin="8,0,0,0" Width="28" Height="28"
                                Click="Mute_Click" ToolTip="Mute">
                            <TextBlock x:Name="MuteGlyph" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="12"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Shortcuts ============ -->
            <UniformGrid Columns="4">
                <Button Style="{StaticResource CircleButton}" Click="Calc_Click" ToolTip="Calculator" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8EF;" FontSize="19"/>
                </Button>
                <Button Style="{StaticResource CircleButton}" Click="Clock_Click" ToolTip="Clock" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" FontSize="19"/>
                </Button>
                <Button Style="{StaticResource CircleButton}" Click="Snip_Click" ToolTip="Screenshot" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" FontSize="19"/>
                </Button>
                <Button Style="{StaticResource CircleButton}" Click="Settings_Click" ToolTip="Windows Settings" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="19"/>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Border>
</shell:OverlayWindow>
