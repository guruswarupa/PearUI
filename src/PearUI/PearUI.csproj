<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PearUI</AssemblyName>
    <RootNamespace>PearUI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The version comes from the newest git tag (v1.2.0 -> 1.2.0), or from -p:Version=… (the release build passes the tag). -->
    <Version>0.0.0</Version>
    <!-- Identity shown by Windows (Task Manager → Startup apps, Properties → Details): name, publisher, icon. -->
    <AssemblyTitle>PearUI</AssemblyTitle>
    <Product>PearUI</Product>
    <Company>Guru Swarupa</Company>
    <Authors>Guru Swarupa</Authors>
    <Copyright>Copyright © Guru Swarupa</Copyright>
    <Description>A macOS-style menu bar, dock, launcher and control center for Windows.</Description>
    <ApplicationIcon>PearUI.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both enabled: keep WinForms/GDI types out of the global namespace to avoid ambiguities. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\debloat.json" LogicalName="PearUI.debloat.json" />
    <EmbeddedResource Include="..\..\.github\apps.json" LogicalName="PearUI.apps.json" />
    <Content Include="info.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="info" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Keep the app's version in step with the release tag, so About, Windows' file properties and the installer always agree. -->
  <Target Name="PearUIVersionFromGitTag" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(PearUIVersionLocked)' != 'true'">
    <Exec Command="git describe --tags --abbrev=0 --match v*" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="PearUIGitTag" />
    </Exec>
    <PropertyGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(PearUIGitTag)', '^v?[0-9]+\.[0-9]+\.[0-9]+'))">
      <Version>$([System.Text.RegularExpressions.Regex]::Match('$(PearUIGitTag)', '[0-9]+\.[0-9]+\.[0-9]+').Value)</Version>
    </PropertyGroup>
  </Target>

</Project>
